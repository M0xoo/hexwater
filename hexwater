#!/usr/bin/env python3
""":" ; exec python3 -u - "$@" << 'raise SystemExit(main())' #"""
"""
hexwater — Terminal honeycomb water-footprint analyzer for local AI coding subscriptions.
Scans local telemetry from:
  - Claude Code   (~/.claude/projects/**/*.jsonl)
  - Codex         (~/.codex/state_5.sqlite)
  - Grok CLI      (~/.grok/sessions/**/usage.json & chat_history.jsonl)
  - Antigravity   (~/.gemini/antigravity-cli/brain/**/.system_generated/logs/transcript.jsonl)
  - OpenCode      (~/.local/share/opencode/opencode.db)
"""

import argparse
import json
import math
import os
import re
import sqlite3
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Tuple

# Energy & Water intensity model (Li et al., "Making AI Less 'Thirsty'", WUE = 1.8 L/kWh combined scope 1+2):
# - Autoregressive output/reasoning decode: ~2.50 Wh / 1k tokens -> 4.50 mL / 1k tokens
# - Uncached prompt prefill (input):        ~0.40 Wh / 1k tokens -> 0.72 mL / 1k tokens
# - KV cache creation (cache write):        ~0.50 Wh / 1k tokens -> 0.90 mL / 1k tokens
# - KV cache hit (cache read):              ~0.04 Wh / 1k tokens -> 0.072 mL / 1k tokens
# - Blended total token fallback (Codex):   ~0.20 Wh / 1k tokens -> 0.36 mL / 1k tokens
ML_PER_1K = {
    "output": 4.50,
    "reasoning": 4.50,
    "input": 0.72,
    "cache_write": 0.90,
    "cache_read": 0.072,
    "blended_total": 0.36,
}


@dataclass
class ProviderUsage:
    key: str
    name: str
    upper_name: str
    symbol: str
    rgb: Tuple[int, int, int]
    sessions: int = 0
    turns: int = 0
    input_tokens: int = 0
    output_tokens: int = 0
    reasoning_tokens: int = 0
    cache_read_tokens: int = 0
    cache_write_tokens: int = 0
    blended_total_tokens: int = 0

    @property
    def total_tokens(self) -> int:
        explicit = (
            self.input_tokens
            + self.output_tokens
            + self.reasoning_tokens
            + self.cache_read_tokens
            + self.cache_write_tokens
        )
        return explicit + self.blended_total_tokens

    def water_ml(self, scale: float = 1.0) -> float:
        ml = (
            (self.input_tokens / 1000.0) * ML_PER_1K["input"]
            + (self.output_tokens / 1000.0) * ML_PER_1K["output"]
            + (self.reasoning_tokens / 1000.0) * ML_PER_1K["reasoning"]
            + (self.cache_write_tokens / 1000.0) * ML_PER_1K["cache_write"]
            + (self.cache_read_tokens / 1000.0) * ML_PER_1K["cache_read"]
            + (self.blended_total_tokens / 1000.0) * ML_PER_1K["blended_total"]
        )
        return ml * scale


def load_cache(cache_path: Path) -> Dict[str, List[int]]:
    if not cache_path.exists():
        return {}
    try:
        with open(cache_path, "r", encoding="utf-8") as f:
            return json.load(f)
    except (OSError, json.JSONDecodeError):
        return {}


def save_cache(cache_path: Path, data: Dict[str, List[int]]) -> None:
    try:
        cache_path.parent.mkdir(parents=True, exist_ok=True)
        with open(cache_path, "w", encoding="utf-8") as f:
            json.dump(data, f)
    except OSError:
        pass


def scan_claude(home: Path, file_cache: Dict[str, List[int]]) -> ProviderUsage:
    u = ProviderUsage("claude", "Claude Code", "CLAUDE CODE", "CL", (232, 133, 97))
    projects_dir = home / ".claude" / "projects"
    if not projects_dir.exists():
        return u

    re_in = re.compile(r'"input_tokens"\s*:\s*(\d+)')
    re_out = re.compile(r'"output_tokens"\s*:\s*(\d+)')
    re_cr = re.compile(r'"cache_read_input_tokens"\s*:\s*(\d+)')
    re_cw = re.compile(r'"cache_creation_input_tokens"\s*:\s*(\d+)')
    re_id = re.compile(r'"id"\s*:\s*"(msg_[^"]+)"')

    for root, _, files in os.walk(projects_dir):
        for fname in files:
            if not fname.endswith(".jsonl"):
                continue
            u.sessions += 1
            fpath = os.path.join(root, fname)
            try:
                st = os.stat(fpath)
            except OSError:
                continue
            cached = file_cache.get(fpath)
            if cached and len(cached) == 7 and cached[0] == st.st_mtime_ns and cached[1] == st.st_size:
                u.turns += cached[2]
                u.input_tokens += cached[3]
                u.output_tokens += cached[4]
                u.cache_read_tokens += cached[5]
                u.cache_write_tokens += cached[6]
                continue

            f_turns = f_in = f_out = f_cr = f_cw = 0
            seen_msgs = set()
            try:
                with open(fpath, "r", encoding="utf-8", errors="ignore") as f:
                    for line in f:
                        if '"usage"' not in line:
                            continue
                        m_id = re_id.search(line)
                        if m_id:
                            msg_id = m_id.group(1)
                            if msg_id in seen_msgs:
                                continue
                            seen_msgs.add(msg_id)
                        m_in = re_in.search(line)
                        m_out = re_out.search(line)
                        m_cr = re_cr.search(line)
                        m_cw = re_cw.search(line)
                        if m_in or m_out:
                            f_turns += 1
                            if m_in:
                                f_in += int(m_in.group(1))
                            if m_out:
                                f_out += int(m_out.group(1))
                            if m_cr:
                                f_cr += int(m_cr.group(1))
                            if m_cw:
                                f_cw += int(m_cw.group(1))
                file_cache[fpath] = [st.st_mtime_ns, st.st_size, f_turns, f_in, f_out, f_cr, f_cw]
                u.turns += f_turns
                u.input_tokens += f_in
                u.output_tokens += f_out
                u.cache_read_tokens += f_cr
                u.cache_write_tokens += f_cw
            except OSError:
                pass
    return u


def scan_codex(home: Path) -> ProviderUsage:
    u = ProviderUsage("codex", "OpenAI Codex", "OPENAI CODEX", "CX", (52, 211, 153))
    db_path = home / ".codex" / "state_5.sqlite"
    if db_path.exists():
        try:
            conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
            cur = conn.cursor()
            cur.execute("SELECT COUNT(*), COALESCE(SUM(tokens_used), 0) FROM threads;")
            row = cur.fetchone()
            if row:
                u.sessions = int(row[0] or 0)
                u.turns = u.sessions
                u.blended_total_tokens = int(row[1] or 0)
            conn.close()
        except sqlite3.Error:
            pass
    return u


def scan_grok(home: Path) -> ProviderUsage:
    u = ProviderUsage("grok", "Grok CLI", "GROK CLI", "GK", (147, 197, 253))
    sessions_dir = home / ".grok" / "sessions"
    if not sessions_dir.exists():
        return u

    for root, _, files in os.walk(sessions_dir):
        if "usage.json" in files:
            u.sessions += 1
            upath = os.path.join(root, "usage.json")
            try:
                with open(upath, "r", encoding="utf-8", errors="ignore") as f:
                    data = json.load(f)
                sess = data.get("session", {})
                in_t = int(sess.get("inputTokens", 0) or 0)
                out_t = int(sess.get("outputTokens", 0) or 0)
                cr_t = int(sess.get("cachedReadTokens", 0) or 0)
                cw_t = int(sess.get("cacheCreationTokens", 0) or 0)
                rs_t = int(sess.get("reasoningTokens", 0) or 0)
                tot_t = int(sess.get("totalTokens", 0) or 0)
                u.turns += int(sess.get("turnCount", 0) or 0)
                if in_t or out_t or cr_t or cw_t or rs_t:
                    u.input_tokens += in_t
                    u.output_tokens += out_t
                    u.cache_read_tokens += cr_t
                    u.cache_write_tokens += cw_t
                    u.reasoning_tokens += rs_t
                elif tot_t > 0:
                    u.blended_total_tokens += tot_t
                else:
                    chpath = os.path.join(root, "chat_history.jsonl")
                    if os.path.exists(chpath):
                        sz = os.path.getsize(chpath)
                        u.input_tokens += sz // 5
                        u.output_tokens += sz // 20
            except (OSError, json.JSONDecodeError):
                pass
    return u


def scan_antigravity(home: Path, file_cache: Dict[str, List[int]]) -> ProviderUsage:
    u = ProviderUsage("antigravity", "Antigravity", "ANTIGRAVITY", "AG", (192, 132, 252))
    brain_dir = home / ".gemini" / "antigravity-cli" / "brain"
    if not brain_dir.exists():
        return u

    re_in = re.compile(r'"input_tokens"\s*:\s*(\d+)')
    re_out = re.compile(r'"output_tokens"\s*:\s*(\d+)')
    re_cr = re.compile(r'"cache_read_tokens"\s*:\s*(\d+)')

    for entry in os.scandir(brain_dir):
        if not entry.is_dir():
            continue
        tpath = os.path.join(entry.path, ".system_generated", "logs", "transcript.jsonl")
        if not os.path.exists(tpath):
            continue
        u.sessions += 1
        try:
            st = os.stat(tpath)
        except OSError:
            continue
        cached = file_cache.get(tpath)
        if cached and len(cached) == 7 and cached[0] == st.st_mtime_ns and cached[1] == st.st_size:
            u.turns += cached[2]
            u.input_tokens += cached[3]
            u.output_tokens += cached[4]
            u.cache_read_tokens += cached[5]
            continue

        f_turns = f_in = f_out = f_cr = 0
        try:
            with open(tpath, "r", encoding="utf-8", errors="ignore") as f:
                for line in f:
                    if '"input_tokens"' not in line and '"output_tokens"' not in line:
                        continue
                    m_in = re_in.search(line)
                    m_out = re_out.search(line)
                    m_cr = re_cr.search(line)
                    f_turns += 1
                    if m_in:
                        f_in += int(m_in.group(1))
                    if m_out:
                        f_out += int(m_out.group(1))
                    if m_cr:
                        f_cr += int(m_cr.group(1))
            file_cache[tpath] = [st.st_mtime_ns, st.st_size, f_turns, f_in, f_out, f_cr, 0]
            u.turns += f_turns
            u.input_tokens += f_in
            u.output_tokens += f_out
            u.cache_read_tokens += f_cr
        except OSError:
            pass
    return u


def scan_opencode(home: Path, file_cache: Dict[str, List[int]]) -> ProviderUsage:
    u = ProviderUsage("opencode", "OpenCode", "OPENCODE", "OC", (56, 189, 248))
    db_path = home / ".local" / "share" / "opencode" / "opencode.db"
    if not db_path.exists():
        return u
    try:
        st = os.stat(db_path)
        ckey = str(db_path)
        cached = file_cache.get(ckey)
        if cached and len(cached) == 9 and cached[0] == st.st_mtime_ns and cached[1] == st.st_size:
            u.sessions = cached[2]
            u.turns = cached[3]
            u.input_tokens = cached[4]
            u.output_tokens = cached[5]
            u.reasoning_tokens = cached[6]
            u.cache_read_tokens = cached[7]
            u.cache_write_tokens = cached[8]
            return u

        conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
        cur = conn.cursor()
        cur.execute("SELECT COUNT(*) FROM session;")
        r_sess = cur.fetchone()
        if r_sess:
            u.sessions = int(r_sess[0] or 0)

        cur.execute(
            """
            SELECT
                COUNT(*),
                COALESCE(SUM(CAST(json_extract(data, '$.tokens.input') AS INTEGER)), 0),
                COALESCE(SUM(CAST(json_extract(data, '$.tokens.output') AS INTEGER)), 0),
                COALESCE(SUM(CAST(json_extract(data, '$.tokens.reasoning') AS INTEGER)), 0),
                COALESCE(SUM(CAST(json_extract(data, '$.tokens.cache.read') AS INTEGER)), 0),
                COALESCE(SUM(CAST(json_extract(data, '$.tokens.cache.write') AS INTEGER)), 0)
            FROM message
            WHERE json_extract(data, '$.tokens') IS NOT NULL;
            """
        )
        row = cur.fetchone()
        if row:
            u.turns = int(row[0] or 0)
            u.input_tokens = int(row[1] or 0)
            u.output_tokens = int(row[2] or 0)
            u.reasoning_tokens = int(row[3] or 0)
            u.cache_read_tokens = int(row[4] or 0)
            u.cache_write_tokens = int(row[5] or 0)
        conn.close()
        file_cache[ckey] = [
            st.st_mtime_ns,
            st.st_size,
            u.sessions,
            u.turns,
            u.input_tokens,
            u.output_tokens,
            u.reasoning_tokens,
            u.cache_read_tokens,
            u.cache_write_tokens,
        ]
    except (sqlite3.Error, OSError):
        pass
    return u


def fg(rgb: Tuple[int, int, int], use_color: bool = True) -> str:
    if not use_color:
        return ""
    return f"\033[38;2;{rgb[0]};{rgb[1]};{rgb[2]}m"


def bold(use_color: bool = True) -> str:
    return "\033[1m" if use_color else ""


def dim(use_color: bool = True) -> str:
    return "\033[2m" if use_color else ""


def reset(use_color: bool = True) -> str:
    return "\033[0m" if use_color else ""


def fmt_tokens(n: int) -> str:
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.1f}B"
    if n >= 100_000_000:
        return f"{n / 1_000_000:.0f}M"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def fmt_water(ml: float) -> str:
    if ml >= 1_000_000.0:
        return f"{ml / 1000.0:,.1f} L"
    if ml >= 1000.0:
        return f"{ml / 1000.0:.1f} L"
    if ml >= 1.0:
        return f"{ml:.1f} mL"
    return f"{ml:.2f} mL"


def hex_bar(ml: float, max_ml: float) -> str:
    """Log-scaled 8-dot bar using exact 1.0ch SF Mono glyphs so hex borders align pixel-perfectly."""
    if ml <= 0 or max_ml <= 0:
        return "○" * 8
    lo = math.log10(max(100.0, min(ml, max_ml) * 0.1))
    hi = math.log10(max(1000.0, max_ml))
    val = math.log10(max(100.0, ml))
    ratio = (val - lo) / max(0.001, (hi - lo))
    filled = max(1, min(8, int(round(ratio * 8))))
    return "●" * filled + "○" * (8 - filled)


def render_dashboard(providers: List[ProviderUsage], scale: float, use_color: bool) -> str:
    """
    Renders a 54-column symmetric 7-hexagon honeycomb flower + compact summary table.
    Fits cleanly inside narrow 58-column terminal panes without any line wrapping.
    """
    c_aqua = fg((56, 189, 248), use_color)
    c_gold = fg((250, 204, 21), use_color)
    c_muted = dim(use_color)
    b = bold(use_color)
    r = reset(use_color)

    total_ml = sum(p.water_ml(scale) for p in providers)
    total_tokens = sum(p.total_tokens for p in providers)
    total_sessions = sum(p.sessions for p in providers)
    total_turns = sum(p.turns for p in providers)

    sorted_p = sorted(providers, key=lambda x: x.water_ml(scale), reverse=True)
    max_ml = max((p.water_ml(scale) for p in sorted_p), default=1.0)

    # 53-col character + ANSI color canvas for the 7-hexagon flower
    W, H = 53, 18
    chars = [[" " for _ in range(W)] for _ in range(H)]
    colors = [["" for _ in range(W)] for _ in range(H)]

    def draw_hex(
        col_idx: int,
        row_offset: int,
        lines: List[str],
        rgb: Tuple[int, int, int],
        highlight_line: int = 1,
    ) -> None:
        x0 = col_idx * 17
        y0 = row_offset
        c_border = fg(rgb, use_color)
        c_title = b + fg(rgb, use_color)
        c_val = b + fg((255, 255, 255), use_color) if use_color else ""
        c_sub = c_muted
        c_bar = fg(rgb, use_color)

        top = "  ▁▁▁▁▁▁▁▁▁▁▁▁▁▁  "
        bot = "  ▔▔▔▔▔▔▔▔▔▔▔▔▔▔  "
        mid_borders = [
            (1, "╱", 16, "╲", lines[0], 14, c_title),
            (0, "╱", 17, "╲", lines[1], 16, c_val if highlight_line == 1 else c_title),
            (0, "╲", 17, "╱", lines[2], 16, c_sub),
            (1, "╲", 16, "╱", lines[3], 14, c_bar),
        ]

        # Top edge
        for dx, ch in enumerate(top):
            if ch != " ":
                chars[y0][x0 + dx] = ch
                colors[y0][x0 + dx] = c_border

        # 4 inner rows
        for idx, (lx, lch, rx, rch, text, width, tcol) in enumerate(mid_borders):
            y = y0 + 1 + idx
            chars[y][x0 + lx] = lch
            colors[y][x0 + lx] = c_border
            chars[y][x0 + rx] = rch
            colors[y][x0 + rx] = c_border
            centered = f"{text:^{width}}"[:width]
            for i, ch in enumerate(centered):
                chars[y][x0 + lx + 1 + i] = ch
                colors[y][x0 + lx + 1 + i] = tcol

        # Bottom edge
        for dx, ch in enumerate(bot):
            if ch != " ":
                chars[y0 + 5][x0 + dx] = ch
                colors[y0 + 5][x0 + dx] = c_border

    def provider_lines(p: ProviderUsage) -> List[str]:
        ml = p.water_ml(scale)
        pct = (ml / total_ml * 100.0) if total_ml > 0 else 0.0
        return [
            p.upper_name[:14],
            fmt_water(ml),
            f"{fmt_tokens(p.total_tokens)} · {pct:.1f}%",
            hex_bar(ml, max_ml),
        ]

    # Positions in the 7-hexagon honeycomb flower:
    # (1, 0) Top-Center, (0, 3) Upper-Left, (2, 3) Upper-Right,
    # (1, 6) Center Core (Total),
    # (0, 9) Lower-Left, (2, 9) Lower-Right, (1, 12) Bottom-Center (Equivalents)
    outer_slots = [(1, 0), (0, 3), (2, 3), (0, 9), (2, 9)]
    for idx, (cx, cy) in enumerate(outer_slots):
        if idx < len(sorted_p):
            p = sorted_p[idx]
            draw_hex(cx, cy, provider_lines(p), p.rgb)

    # Center Core Hex: Total Water
    draw_hex(
        1,
        6,
        [
            "TOTAL WATER",
            fmt_water(total_ml),
            f"{fmt_tokens(total_tokens)} tokens",
            f"{total_sessions:,} sess",
        ],
        (56, 189, 248),
    )

    # Bottom Hex: Real-world Equivalents
    bottles = int(round(total_ml / 500.0))
    glasses = total_ml / 250.0
    shots = total_ml / 30.0
    glasses_s = f"{glasses / 1000.0:.1f}k" if glasses >= 1000 else f"{glasses:.0f}"
    shots_s = f"{shots / 1000.0:.0f}k" if shots >= 1000 else f"{shots:.0f}"
    draw_hex(
        1,
        12,
        [
            "EQUIVALENTS",
            f"{bottles:,} bottles",
            f"{glasses_s} glasses",
            f"{shots_s} shots",
        ],
        (250, 204, 21),
    )

    out: List[str] = []
    out.append("")
    out.append(f" {c_aqua}{b}⬢ HEXWATER{r} {c_muted}· AI Subscription Water Footprint{r}")
    out.append(f" {c_muted}{'═' * 52}{r}")

    for y in range(H):
        line_parts = [" "]
        cur_col = ""
        last_non_space = -1
        for x in range(W):
            if chars[y][x] != " ":
                last_non_space = x
        for x in range(last_non_space + 1):
            if colors[y][x] != cur_col:
                line_parts.append(r + colors[y][x])
                cur_col = colors[y][x]
            line_parts.append(chars[y][x])
        if cur_col:
            line_parts.append(r)
        out.append("".join(line_parts))

    out.append(f" {c_muted}{'─' * 52}{r}")
    out.append(f" {b}PROVIDER       SESS   TOKENS      WATER    SHARE{r}")
    out.append(f" {c_muted}{'─' * 52}{r}")

    for p in sorted_p:
        ml = p.water_ml(scale)
        pct = (ml / total_ml * 100.0) if total_ml > 0 else 0.0
        cp = fg(p.rgb, use_color)
        out.append(
            f" {cp}●{r} {p.name:<12} {p.sessions:>4} {fmt_tokens(p.total_tokens):>8} "
            f"{cp}{b}{fmt_water(ml):>10}{r}  {pct:>6.1f}%"
        )

    out.append(f" {c_muted}{'─' * 52}{r}")
    out.append(
        f" {c_muted}WUE {1.8 * scale:.2f} L/kWh · {total_turns:,} turns · 1 bottle = 500 mL{r}"
    )
    out.append("")
    return "\n".join(out)


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Show water consumption across your local AI coding subscriptions in a terminal honeycomb."
    )
    parser.add_argument(
        "--home",
        default=os.path.expanduser("~"),
        help="Home directory to scan (default: ~)",
    )
    parser.add_argument(
        "--wue",
        type=float,
        default=1.8,
        help="Combined Scope 1+2 Water Usage Effectiveness in L/kWh (default: 1.8)",
    )
    parser.add_argument(
        "--json",
        action="store_true",
        help="Emit machine-readable JSON instead of the terminal hex dashboard",
    )
    parser.add_argument(
        "--no-color",
        action="store_true",
        help="Disable ANSI 24-bit color escape codes",
    )
    parser.add_argument(
        "--no-cache",
        action="store_true",
        help="Bypass the mtime/size token cache",
    )
    parser.add_argument(
        "--stats",
        action="store_true",
        help="Check global execution/download counts for Method 1 (curl|bash) vs Method 2 (install.sh)",
    )
    args = parser.parse_args()

    if args.stats:
        import urllib.request
        url = "https://api.github.com/repos/M0xoo/hexwater/releases/latest"
        try:
            req = urllib.request.Request(url, headers={"User-Agent": "hexwater-cli"})
            with urllib.request.urlopen(req, timeout=5) as resp:
                rel = json.loads(resp.read().decode("utf-8"))
            assets = {a["name"]: a["download_count"] for a in rel.get("assets", [])}
            m1 = assets.get("hexwater", 0)
            m2 = assets.get("install.sh", 0)
            if args.json:
                print(json.dumps({"release": rel.get("tag_name"), "method1_curl_bash": m1, "method2_install_sh": m2}, indent=2))
            else:
                use_color = not args.no_color and sys.stdout.isatty()
                c_aqua = fg((56, 189, 248), use_color)
                b = bold(use_color)
                r = reset(use_color)
                print(f"\n {c_aqua}{b}⬢ HEXWATER USAGE STATS{r} ({rel.get('tag_name', 'latest')})")
                print(f" ────────────────────────────────────────────────────")
                print(f" Method 1 (curl .../hexwater | bash)   : {b}{m1:,}{r} runs")
                print(f" Method 2 (curl .../install.sh | bash) : {b}{m2:,}{r} installs\n")
            return 0
        except Exception as exc:
            print(f"Error fetching release stats: {exc}", file=sys.stderr)
            return 1

    home = Path(args.home)
    cache_path = home / ".cache" / "hexwater" / "token_cache_v1.json"
    file_cache = {} if args.no_cache else load_cache(cache_path)

    scale = args.wue / 1.8
    providers = [
        scan_claude(home, file_cache),
        scan_opencode(home, file_cache),
        scan_antigravity(home, file_cache),
        scan_codex(home),
        scan_grok(home),
    ]

    if not args.no_cache:
        save_cache(cache_path, file_cache)

    if args.json:
        payload = {
            "wue_l_per_kwh": args.wue,
            "total_water_ml": round(sum(p.water_ml(scale) for p in providers), 2),
            "total_water_liters": round(sum(p.water_ml(scale) for p in providers) / 1000.0, 4),
            "total_tokens": sum(p.total_tokens for p in providers),
            "providers": [
                {
                    "key": p.key,
                    "name": p.name,
                    "symbol": p.symbol,
                    "sessions": p.sessions,
                    "turns": p.turns,
                    "input_tokens": p.input_tokens,
                    "output_tokens": p.output_tokens,
                    "reasoning_tokens": p.reasoning_tokens,
                    "cache_read_tokens": p.cache_read_tokens,
                    "cache_write_tokens": p.cache_write_tokens,
                    "blended_total_tokens": p.blended_total_tokens,
                    "total_tokens": p.total_tokens,
                    "water_ml": round(p.water_ml(scale), 2),
                }
                for p in sorted(providers, key=lambda x: x.water_ml(scale), reverse=True)
            ],
        }
        print(json.dumps(payload, indent=2))
        return 0

    use_color = not args.no_color and sys.stdout.isatty()
    if os.environ.get("FORCE_COLOR"):
        use_color = not args.no_color
    print(render_dashboard(providers, scale, use_color))
    return 0


